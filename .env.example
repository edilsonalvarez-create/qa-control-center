# Copy to .env. Never commit real secrets.

# --- API ---
NODE_ENV=development
PORT=8080
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# PostgreSQL (local docker-compose or Railway)
DATABASE_URL=postgresql://qacc:qacc@localhost:5432/qa_control_center?schema=public

# Bootstrap admin (seed only)
ADMIN_EMAIL=admin@qacc.local
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=QA Admin

# --- Web (Vite) ---
VITE_API_URL=http://localhost:8080

# --- Google Drive (Phase 4 — leave empty in MVP) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/integrations/google/callback
GOOGLE_DRIVE_FOLDER_ID=1hCe3QBPraJEvt6H60KcCOiNIFzG6zdL-
